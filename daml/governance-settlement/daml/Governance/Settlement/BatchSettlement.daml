-- | A Token Standard V2 batch settlement as a governed action.
--
-- The one thing this module adds to a settlement is who may execute it.
-- Token Standard V2 settles a batch only with the authority of every party
-- in the settlement's executors (SettlementFactory_SettleBatch is
-- controlled by its actors, and the standard's default implementation
-- requires actors to equal the executors). So an application that names a
-- decentralised party among the executors when it allocates has made every
-- settlement of that batch require that party's authority, and a
-- decentralised party acts only when its members have confirmed to
-- threshold. This template is the proposal that carries the settlement
-- through that vote.
--
-- Who does what:
--
--   * the proposer files the batch: it is the application's executor (a
--     paying agent, a venue, a treasury), admitted to the governance rules
--     as a member or as an additional proposer;
--   * the members confirm, to threshold, through the Decentralization
--     Manager;
--   * any member executes; the engine exercises GovernableAction_Execute
--     with the governance party's authority, and executeImpl runs with that
--     authority plus the proposer's, which is exactly the set of actors the
--     settlement needs.
--
-- Below threshold nothing can execute. Outside the vote nothing can settle:
-- the proposer alone lacks the governance party's authority and the
-- standard refuses the batch.
--
-- What the executor sees: everything, as executors do under the standard
-- (allocations list their executors as observers). That is the trade the
-- application makes when it asks a committee to approve a payout, and it
-- should be said in the application's own terms.
module Governance.Settlement.BatchSettlement where

import DA.List (unique)

import Governance.Action
import Splice.Api.Token.MetadataV1 (ExtraArgs)
import Splice.Api.Token.AllocationV2 qualified as V2

-- | One batch settlement, proposed for approval.
template BatchSettlementProposal
  with
    governanceParty : Party
      -- ^ The decentralised party whose members must confirm. It must be
      -- one of the settlement's executors, or executing would be pointless.
    proposer        : Party
      -- ^ The application's executor, who also signs this proposal.
    factoryCid      : ContractId V2.SettlementFactory
      -- ^ The registry's settlement factory. Its contract is normally
      -- disclosed at execution time by the caller.
    settlement      : V2.SettlementInfo
      -- ^ The settlement every allocation of the batch was made for.
    transferLegs    : [V2.TransferLeg]
      -- ^ Every leg of the batch, exactly as the allocations authorise them.
    allocationCids  : [ContractId V2.Allocation]
      -- ^ The allocations that authorise the legs: every sender's and every
      -- receiver's. The standard checks completeness; this template does not.
    extraArgs       : ExtraArgs
      -- ^ The registry's choice context, e.g. its rules contract id.
    label           : Text
      -- ^ Groups this action in the audit trail. Stable per application,
      -- e.g. "BatchSettlement" or "CouponSettlement".
    description     : Text
      -- ^ What the members are asked to approve, in words. Copied verbatim
      -- into GovernanceExecutionResult, so it is the permanent record.
  where
    signatory proposer
    observer governanceParty

    ensure
      governanceParty `elem` settlement.executors
        && proposer `elem` settlement.executors
        && not (null allocationCids)
        && not (null transferLegs)
        && unique (map (.transferLegId) transferLegs)

    interface instance GovernableAction for BatchSettlementProposal where
      view = GovernableActionView with
        governanceParty
        proposer
        actionLabel = label
        description

      executeImpl = do
        _ <- exercise factoryCid V2.SettlementFactory_SettleBatch with
          settlement
          transferLegs
          allocations =
            [ V2.FinalizedAllocation with
                allocationCid
                extraTransferLegSides = []
                nextIterationFunding = None
            | allocationCid <- allocationCids
            ]
          actors = settlement.executors
          extraArgs
        pure ()
