-- | What the batch-settlement test needs from a cash instrument, and nothing
-- more.
--
-- These helpers exist so the test for a module that depends on no
-- application can itself depend on no application. They are the Token
-- Standard's own reference asset driven the way a wallet would drive it:
-- mint through the registry, read balances through the Holding interface,
-- build the two allocation shapes the standard distinguishes.
--
-- Ported from Indivisa's own fixtures, which is where they were written and
-- proven; the comments that explain WHY each one is shaped as it is have
-- been kept, because they are the part that cost the time.
module Governance.Settlement.TestUtils where

import DA.Exception (GeneralError(..), fromAnyException)
import DA.Optional (isNone)
import DA.TextMap qualified as TextMap
import DA.Time (addRelTime, minutes)

import Daml.Script

import Splice.Api.Token.MetadataV1
import Splice.Api.Token.HoldingV2 qualified as V2
import Splice.Api.Token.AllocationV2 qualified as V2
import Splice.Api.Token.TransferInstructionV2 qualified as V2
import Splice.TokenStandard.Utils (basicAccount, receiverSide, senderSide, toAnyContractId)
import Splice.Testing.Tokens.TestTokenV2 qualified as TestTokenV2
import Splice.Testing.Tokens.TestTokenV2.Util (tokenRulesContextKey)

-- | The cash instrument as a client sees it: the registry's factory contract
-- (disclosed, so non-signatories can exercise it), the instrument id, and the
-- registry's choice context. In production the last two come from the
-- registry's off-ledger API; TestTokenV2 wants exactly one entry, its own
-- rules contract.
data Cash = Cash
  with
    rulesCid   : ContractId TestTokenV2.TokenRules
    instrument : V2.InstrumentId
    extraArgs  : ExtraArgs
    rules      : Disclosure

-- | A registry party with a cash instrument ready to mint.
setupCash : Script (Party, Cash)
setupCash = do
  registry <- allocateParty "CashRegistry"
  rulesCid <- submit registry $ createCmd TestTokenV2.TokenRules with admin = registry
  Some rules <- queryDisclosure registry rulesCid
  let instrument = V2.InstrumentId with admin = registry; id = "USD"
      extraArgs = ExtraArgs with
        context = ChoiceContext with
          values = TextMap.fromList
            [(tokenRulesContextKey, AV_ContractId (toAnyContractId rulesCid))]
        meta = emptyMetadata
  pure (registry, Cash with ..)

-- | Minted the way the reference token mints: the registry offers
-- (TokenRules_OfferMint), the owner accepts the resulting transfer
-- instruction. Two commands from two parties, which is also why it works
-- across participants.
fund : Cash -> Party -> Decimal -> Script ()
fund cash owner amount = do
  let registry = cash.instrument.admin
      account = basicAccount owner
  now <- requestedAt
  offer <- submit registry $ exerciseCmd cash.rulesCid TestTokenV2.TokenRules_OfferMint with
    receiver = account
    amount
    instrumentId = cash.instrument
    offeredAt = now
    receiverConfig = TestTokenV2.AccountConfig with
      admin = registry
      account
      ownerConfig = TestTokenV2.PartyConfig with canInitiate = True; mustApprove = True
      providerConfig = TestTokenV2.PartyConfig with canInitiate = False; mustApprove = False
  result <- submit (actAs owner <> disclose cash.rules) $
    exerciseCmd (toInterfaceContractId @V2.TransferInstruction offer.offerCid)
      V2.TransferInstruction_Accept with
        actors = [owner]
        extraArgs = cash.extraArgs
  case result.output of
    V2.TransferInstructionResult_Completed _ -> pure ()
    _ -> fail "mint offer was not completed on accept"

-- | What a wallet stamps on an allocation request: its clock, now, less a
-- little. TestTokenV2 requires ledger time >= requestedAt as a ledger-time
-- bound, and a participant stamps ledger time from its own clock when it
-- interprets the command - a clock a few hundred milliseconds behind the
-- caller's is enough to make "now" strictly after ledger time. A request
-- stamped a little in the past is just as valid, and another operator's
-- clock is never yours.
requestedAt : Script Time
requestedAt = do
  now <- getTime
  pure (now `addRelTime` minutes (-5))

-- | Holdings of a party's own basic account, through the V2 Holding
-- interface. That is the strong form: the query does not know the registry's
-- templates.
holdings : Cash -> Party -> Script [(ContractId V2.Holding, V2.HoldingView)]
holdings cash p = do
  hs <- queryInterface @V2.Holding p
  pure
    [ (cid, v)
    | (cid, Some v) <- hs
    , v.account == basicAccount p
    , v.instrumentId == cash.instrument
    ]

balance : Cash -> Party -> Script Decimal
balance cash p = do
  hs <- holdings cash p
  pure $ sum [ v.amount | (_, v) <- hs, isNone v.lock ]

unlockedHoldingCids : Cash -> Party -> Script [ContractId V2.Holding]
unlockedHoldingCids cash p = do
  hs <- holdings cash p
  pure [ cid | (cid, v) <- hs, isNone v.lock ]

-- | The sender's side: one allocation funding every leg. Committed, so the
-- sender cannot withdraw it and race the settlement - which is exactly what
-- the executors are relying on when they approve.
sendAllocationSpec : V2.InstrumentId -> V2.Account -> [V2.TransferLeg] -> V2.AllocationSpecification
sendAllocationSpec instrument senderAccount legs = V2.AllocationSpecification with
  admin = instrument.admin
  authorizer = senderAccount
  transferLegSides = map senderSide legs
  settlementDeadline = None
  nextIterationFunding = None
  committed = True
  meta = emptyMetadata

-- | A receiver's side: the receipt of exactly its own legs. Not committed and
-- with no funding, which is what the standard's receipt check insists on.
receiptAllocationSpec : V2.InstrumentId -> V2.Account -> [V2.TransferLeg] -> V2.AllocationSpecification
receiptAllocationSpec instrument account legs = V2.AllocationSpecification with
  admin = instrument.admin
  authorizer = account
  transferLegSides = map receiverSide legs
  settlementDeadline = None
  nextIterationFunding = None
  committed = False
  meta = emptyMetadata

-- | The message a failed submission carries. Recorded, not just matched:
-- error shapes change between Canton releases and a regression test should
-- say what it saw.
errorText : SubmitError -> Text
errorText err = case err of
  UnhandledException (Some exc) ->
    case fromAnyException exc of
      Some (GeneralError msg) -> msg
      None -> "unhandled exception of another type"
  UnhandledException None -> "unhandled exception"
  AuthorizationError msg -> "authorization error: " <> msg
  other -> show other
